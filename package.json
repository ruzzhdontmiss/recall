{
  "name": "supermemory-clone",
  "version": "0.1.0",
  "description": "A self-hosted clone of the core supermemory.ai loop: add content, extract memories, build a user profile, hybrid search. Zero external services required.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "db:migrate-json": "node scripts/db-migrate-json.js",
    "eval:search": "node scripts/eval-search.js",
    "eval:extract": "node scripts/eval-extract.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2"
  }
}
