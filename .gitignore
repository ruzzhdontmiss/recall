# Dependencies (regenerated with npm ci)
node_modules/

# Local user data & JSON store — never commit
data/
store.json

# SQLite databases and sidecar files — never commit
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Environment files & secrets (safe example placeholder is allowed)
.env
.env.*
!.env.example

# Logs, temporary files, uploads and caches
*.log
logs/
tmp/
uploads/
.cache/
*.tmp

# OS noise
.DS_Store
