# Copy to .env and adjust. Never commit real secrets.

# ---- Server ----
# PORT=6767
# HOST=127.0.0.1                    # loopback by default; set 0.0.0.0 only behind a
#                                   #   firewall/TLS and with AUTH_MODE=required

# ---- Storage ----
# DATA_DIR=./data
# STORAGE_BACKEND=sqlite            # sqlite (default) | json (legacy/rollback)
# SQLITE_FILE=./data/recall.db
# STORE_FILE=./data/store.json

# ---- Auth ----
# Authentication is ON by default. Bootstrap a key with:
#   npm run key:create -- --tenant <tenant> --container <container>
# AUTH_MODE=required                # required (default) | dev
# When AUTH_MODE=dev, unauthenticated /v1 requests are treated as one local tenant.
# It is refused when NODE_ENV=production. Never enable it on a shared host.
# DEV_TENANT=dev
# DEV_CONTAINER=dev

# ---- Rate limiting (per key, per minute) ----
# RATE_LIMIT_PER_MIN=120
# RATE_LIMIT_EXPENSIVE_PER_MIN=30   # for /v1/add and /v1/search

# ---- CORS (off by default; explicit allowlist only, never a wildcard) ----
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ---- Embeddings ----
# EMBEDDINGS_PROVIDER=xenova        # xenova (default) | openai | gemini | tfidf
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DTYPE=q8               # local precision; q8 matches the stored vector
#                                   # space. Changing it re-embeds on access — run
#                                   # `npm run embeddings:reindex` afterwards.
#                                   # The local space also encodes the installed
#                                   # @huggingface/transformers + onnxruntime-node
#                                   # versions. To roll back the embedding stack, run
#                                   # `npm run embeddings:reset -- --apply` first (README).
# EMBEDDINGS_CACHE_DIR=             # durable model cache dir (default lives inside
#                                   # node_modules and is wiped by `npm ci`)
# EMBEDDINGS_LOCAL_MODEL_PATH=      # load models from a local dir (offline installs)
# EMBEDDINGS_OFFLINE=false          # true = never fetch models from the network
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ---- Extraction ----
# EXTRACTION_PROVIDER=auto          # auto | openai | anthropic | gemini | regex
# EXTRACTION_MODEL=
# ANTHROPIC_API_KEY=

# ---- Document ingestion (POST /v1/documents/upload) ----
# UPLOAD_DIR=./data/uploads          # private file storage (dirs 0700, files 0600)
# MAX_UPLOAD_BYTES=10485760          # 10 MiB hard cap per uploaded file
# MAX_PDF_PAGES=500                  # reject PDFs beyond this page count
# PDF_EXTRACT_TIMEOUT_MS=20000       # wall-clock bound on PDF parsing; the worker
#                                    #   thread is terminated when it is exceeded
# PDF_MAX_CONCURRENT=2               # PDFs parsed at once (one worker thread each)
# PDF_MAX_QUEUE=64                   # max uploads waiting for a PDF worker slot
# PDF_WORKER_HEAP_MB=0               # per-worker old-space cap in MiB (0 = Node default)
# MAX_EXTRACTED_CHARS=2000000        # reject documents extracting more text than this
# CHUNK_SIZE=1200                    # target characters per chunk
# CHUNK_OVERLAP=200                  # overlapping characters between chunks
# MAX_CHUNKS=2000                    # reject documents that produce more chunks
# EMBED_BATCH_SIZE=64                # texts embedded per batch

# ---- Storage reconciliation (npm run storage:reconcile) ----
# STORAGE_RECONCILE_GRACE_MS=3600000 # files newer than this are treated as possibly
#                                    #   in flight and are never deleted as orphans
